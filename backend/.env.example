# OpenAI (required for production LLM + embeddings)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# RAG retrieval
TOP_K=5
# Use ~0.72 with OpenAI embeddings. Offline/fake embeddings typically need ~0.30.
RELEVANCE_THRESHOLD=0.72

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Paths (relative to backend/)
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
DOCUMENTS_DB=./data/documents.json

# Set true to force deterministic offline embeddings (no OpenAI calls)
USE_FAKE_EMBEDDINGS=false

# Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
